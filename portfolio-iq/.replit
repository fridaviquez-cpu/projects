modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "csv-parser"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "guest-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "wealth-regression"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "csv-parser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx ../artifacts/portfolio-iq/src/lib/__tests__/csv-import.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "guest-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:guest"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "wealth-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:wealth"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
