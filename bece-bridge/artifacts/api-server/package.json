{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:parser": "node --test tests/request-parser.test.mjs",
    "test:bridge": "node tests/run.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.3",
    "multer": "^2.5.0",
    "openid-client": "^6.8.9",
    "pdf-parse": "^2.4.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0"
  }
}
